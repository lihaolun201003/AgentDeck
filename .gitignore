# --- 虚拟环境 -----------------------------------------------------------
.venv/
venv/
env/

# --- 构建产物（PyInstaller，可随时用 build.bat 重建） -------------------
build/
dist/
*.egg-info/

# --- 本机备份（开发过程中的快照，不进入仓库） --------------------------
backups/

# --- 运行时用户数据（收藏、最近使用、窗口位置、自检结果） --------------
# prompts/ 保留在仓库里作为示例；data/ 属于每个用户自己的运行状态。
data/

# --- Python 缓存 --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- 编辑器 / 操作系统 ------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# --- 含本机路径的截图 --------------------------------------------------
# 设置对话框会显示本机 config.json 的绝对路径，该截图不适合入库。
# 需要时用 tests/render_screenshots.py 在本地重新生成。
docs/screenshots/05-settings.png
